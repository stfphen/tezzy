# ---------------------------------------------------------------------------
# Tezzy — environment template. Copy to .env.local for development, and set the
# same keys in your Vercel project settings for preview/production.
#
#   cp .env.example .env.local
#
# Every value below is OPTIONAL. With none of them set the site builds, runs and
# the booking form works — enquiries are logged to the server console instead of
# being delivered, so you can test the whole flow before any account exists.
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadataBase, canonical URLs, sitemap.xml,
# robots.txt and the JSON-LD graph. No trailing slash.
# Defaults to https://tezzy.ca.
NEXT_PUBLIC_SITE_URL=https://tezzy.ca

# --- Booking delivery: option 1, email via Resend -------------------------
# Create a key at https://resend.com/api-keys and verify your sending domain.
# Setting RESEND_API_KEY turns email delivery on.
RESEND_API_KEY=
# Where enquiries land. Defaults to the bookingEmail in lib/site.ts.
BOOKING_TO_EMAIL=events@tezzy.ca
# Must be on a domain verified in Resend.
BOOKING_FROM_EMAIL=Tezzy <bookings@tezzy.ca>

# --- Booking delivery: option 2, webhook ----------------------------------
# Any endpoint that accepts a JSON POST — Zapier, Make, Slack, a CRM, n8n.
# Can be used on its own or alongside Resend (both fire; either succeeding is
# enough for the visitor to get a success response).
BOOKING_WEBHOOK_URL=
